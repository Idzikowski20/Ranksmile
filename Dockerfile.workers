FROM node:22-alpine
WORKDIR /app
ENV PIPELINE_INLINE_WORKERS=0
ENV PIPELINE_STAGE=5
ENV REDISMS_DISABLE_POSTINSTALL=1

COPY package.json package-lock.json .npmrc ./
# tsx is a devDependency. Skip lifecycle scripts until sources are present
# (root postinstall patches jsdiff and needs scripts/ on disk).
RUN npm ci --omit=dev --ignore-scripts \
 && npm install --no-save --ignore-scripts tsx@4.22.4 \
 && node -e "require('tsx/package.json')"

ENV NODE_ENV=production
COPY . .
CMD ["npx", "tsx", "scripts/pipeline-workers.ts"]
