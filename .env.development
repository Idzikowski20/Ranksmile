# Local `npm run dev` defaults (.env.local overrides secrets + any of these).
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
NEXTJS_URL=http://127.0.0.1:3000
PYTHON_SIDECAR_URL=http://127.0.0.1:8001

# Pipeline v7 — full mode + Redis-backed workers (mprocs: redis + pipeline-workers)
PIPELINE_STAGE=5
REDIS_URL=redis://127.0.0.1:6379
# 0 = jobs go through BullMQ → pipeline-workers (no double-run with Next)
PIPELINE_INLINE_WORKERS=0
