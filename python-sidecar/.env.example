# Copy to python-sidecar/.env OR rely on project-root .env.local (loaded automatically).
PORT=8001

# Local only. On Render NEVER set this to 127.0.0.1 — deep-analysis Node now
# also passes nextjsUrl, and local URLs are ignored when RENDER=true.
# NEXTJS_URL=http://127.0.0.1:3000
# Production on Render (auto-detected via RENDER=true if unset):
# NEXTJS_URL=https://ranksmile.pl
NEXTJS_URL=

# Must match INTERNAL_PIPELINE_TOKEN in .env.local / Railway / Render
INTERNAL_PIPELINE_TOKEN=

# Article generation (OpenRouter — openai/gpt-5.6-luna)
OPENROUTER_API_KEY=

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
