# Copy to python-sidecar/.env OR rely on project-root .env.local (loaded automatically).
PORT=8001

# Local dev (see project-root .env.development):
# NEXTJS_URL=http://127.0.0.1:3000
# Production on Render (auto-detected via RENDER=true if unset):
# NEXTJS_URL=https://serp-bear-neon.vercel.app
NEXTJS_URL=

# Must match INTERNAL_PIPELINE_TOKEN in .env.local / Vercel / Render
INTERNAL_PIPELINE_TOKEN=

ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
SERPER_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
