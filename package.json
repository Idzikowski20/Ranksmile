{
  "name": "ranksmile",
  "version": "3.1.0",
  "private": true,
  "scripts": {
    "dev": "mprocs",
    "dev:next": "next dev",
    "dev:sidecar": "cmd /C python-sidecar\\dev.cmd",
    "setup:sidecar": "cmd /C \"cd python-sidecar && if not exist .venv\\Scripts\\python.exe (python -m venv .venv && .venv\\Scripts\\python.exe -m pip install -r requirements.txt)\"",
    "build": "node scripts/patch-jsdiff-word.js && next build",
    "postinstall": "node scripts/patch-jsdiff-word.js",
    "start": "next start",
    "cron": "node cron.js",
    "start:all": "concurrently npm:start npm:cron",
    "lint": "next lint && node scripts/check-koala-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "jest --watch --verbose",
    "test:ci": "jest --ci",
    "test:arch": "jest __tests__/architecture/cia-boundaries.test.ts --ci",
    "test:e2e": "playwright test e2e/smoke.spec.ts",
    "test:visual": "playwright test e2e/visual",
    "test:visual:update": "playwright test e2e/visual --update-snapshots",
    "check:koala-tokens": "node scripts/check-koala-tokens.mjs",
    "token:debt": "node scripts/token-debt-report.mjs",
    "token:debt:write": "node scripts/token-debt-report.mjs --write-baseline",
    "dead:exports": "node scripts/dead-exports-report.mjs",
    "dead:exports:write": "node scripts/dead-exports-report.mjs --write-baseline",
    "smoke:min": "node scripts/smoke-min.mjs",
    "wie:e2e": "node scripts/wie-eval.mjs",
    "analyze": "cross-env ANALYZE=true next build",
    "budget": "node scripts/check-bundle-budget.mjs",
    "test:cv": "jest --coverage --coverageDirectory='coverage'",
    "db:migrate": "sequelize-cli db:migrate --env production",
    "db:revert": "sequelize-cli db:migrate:undo --env production",
    "release": "standard-version",
    "stripe:seed": "tsx scripts/seed-stripe-products.ts",
    "stripe:seed:cli": "powershell -ExecutionPolicy Bypass -File scripts/seed-stripe-products.ps1",
    "stripe:login": "powershell -ExecutionPolicy Bypass -File scripts/stripe.ps1 login",
    "stripe:listen": "powershell -ExecutionPolicy Bypass -File scripts/stripe.ps1 listen --forward-to localhost:3000/api/webhooks/stripe",
    "pipeline:workers": "tsx scripts/pipeline-workers.ts",
    "pipeline:redis": "tsx scripts/dev-redis.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.16",
    "@ai-sdk/google": "^3.0.103",
    "@aws-sdk/client-s3": "^3.1098.0",
