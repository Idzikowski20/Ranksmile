    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^10.69.0",
    "@sparticuz/chromium-min": "^133.0.0",
    "@stripe/react-stripe-js": "^6.8.0",
    "@stripe/stripe-js": "^9.12.1",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-character-count": "^3.29.2",
    "@tiptap/extension-details": "^3.29.2",
