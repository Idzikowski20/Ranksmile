USER=
PASSWORD=
SECRET=
APIKEY=
SESSION_DURATION=

# === App URLs (see also .env.development / .env.production) ===
# Local:  NEXT_PUBLIC_APP_URL=http://localhost:3000  NEXTJS_URL=http://127.0.0.1:3000
# Prod:   NEXT_PUBLIC_APP_URL=https://serp-bear-neon.vercel.app
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
NEXTJS_URL=

# === SEO Autopilot / Python sidecar ===
# Local:  PYTHON_SIDECAR_URL=http://127.0.0.1:8001
# Prod:   PYTHON_SIDECAR_URL=https://serpbear-sidecar.onrender.com
PYTHON_SIDECAR_URL=
# Shared secret — MUST match on Vercel and Render (sidecar auth + internal API routes).
INTERNAL_PIPELINE_TOKEN=
CRON_SECRET=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
TOGETHER_API_KEY=
HELICONE_API_KEY=
SERPER_API_KEY=
DATABASE_URL=

# DataForSEO (paid reverse-index: keyword ideas+volume+difficulty, competitor gap).
# Basic auth — leave blank to disable and fall back to the free stack.
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=

# Stripe billing (subscriptions). Create Products + recurring Prices in Stripe Dashboard,
# then paste price_... IDs below. Webhook: POST /api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_SCALE_MONTHLY=
STRIPE_PRICE_SCALE_YEARLY=
STRIPE_PRICE_AGENCY_MONTHLY=
STRIPE_PRICE_AGENCY_YEARLY=

# 64 character random string to encrypt the session cookie
#
# We're generating a secret for your convenience, but for production,
# generate your own secret using `openssl rand -hex 32`
AUTH0_SECRET=

# Neon Auth user id whose default workspace absorbs legacy (pre-tenancy) domains
# on first login. Leave empty to keep legacy domains unassigned (claim via admin tools).
TENANCY_OWNER_USER_ID=
# Realtime comments (editor share / live presence). Create a free app at https://ably.com
# and paste the API key — required on Vercel Production for /api/ably-token.
ABLY_API_KEY=
